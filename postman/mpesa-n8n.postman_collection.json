{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "n8n M-Pesa Course",
    "description": "Test collection for Daraja sandbox + your n8n webhooks.\n\nSet the collection variables under the 'Variables' tab before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Daraja (Direct)",
      "item": [
        {
          "name": "1. OAuth - Get Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('access_token', res.access_token);",
                  "  pm.test('token received', () => pm.expect(res.access_token).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{consumer_key}}", "type": "string" },
                { "key": "password", "value": "{{consumer_secret}}", "type": "string" }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{mpesa_base_url}}/oauth/v1/generate?grant_type=client_credentials",
              "host": ["{{mpesa_base_url}}"],
              "path": ["oauth", "v1", "generate"],
              "query": [{ "key": "grant_type", "value": "client_credentials" }]
            }
          }
        },
        {
          "name": "2. STK Push - processrequest",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Build timestamp YYYYMMDDHHmmss in Africa/Nairobi",
                  "const pad = (n) => String(n).padStart(2,'0');",
                  "const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Nairobi' }));",
                  "const ts = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;",
                  "pm.collectionVariables.set('timestamp', ts);",
                  "const raw = pm.collectionVariables.get('shortcode') + pm.collectionVariables.get('passkey') + ts;",
                  "pm.collectionVariables.set('password', Buffer.from(raw).toString('base64'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.CheckoutRequestID) pm.collectionVariables.set('checkout_request_id', res.CheckoutRequestID);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"BusinessShortCode\": {{shortcode}},\n  \"Password\": \"{{password}}\",\n  \"Timestamp\": \"{{timestamp}}\",\n  \"TransactionType\": \"CustomerPayBillOnline\",\n  \"Amount\": 1,\n  \"PartyA\": {{test_phone}},\n  \"PartyB\": {{shortcode}},\n  \"PhoneNumber\": {{test_phone}},\n  \"CallBackURL\": \"{{callback_base_url}}/webhook/mpesa/stk-callback\",\n  \"AccountReference\": \"COURSE-TEST\",\n  \"TransactionDesc\": \"Course Test\"\n}"
            },
            "url": {
              "raw": "{{mpesa_base_url}}/mpesa/stkpush/v1/processrequest",
              "host": ["{{mpesa_base_url}}"],
              "path": ["mpesa", "stkpush", "v1", "processrequest"]
            }
          }
        },
        {
          "name": "3. STK Push Query - status",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pad = (n) => String(n).padStart(2,'0');",
                  "const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Nairobi' }));",
                  "const ts = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;",
                  "pm.collectionVariables.set('timestamp', ts);",
                  "const raw = pm.collectionVariables.get('shortcode') + pm.collectionVariables.get('passkey') + ts;",
                  "pm.collectionVariables.set('password', Buffer.from(raw).toString('base64'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"BusinessShortCode\": {{shortcode}},\n  \"Password\": \"{{password}}\",\n  \"Timestamp\": \"{{timestamp}}\",\n  \"CheckoutRequestID\": \"{{checkout_request_id}}\"\n}"
            },
            "url": {
              "raw": "{{mpesa_base_url}}/mpesa/stkpushquery/v1/query",
              "host": ["{{mpesa_base_url}}"],
              "path": ["mpesa", "stkpushquery", "v1", "query"]
            }
          }
        }
      ]
    },
    {
      "name": "n8n Webhooks (Your Workflows)",
      "item": [
        {
          "name": "Trigger STK Push via n8n",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"254708374149\",\n  \"amount\": 1,\n  \"reference\": \"ORDER-1001\",\n  \"description\": \"Test order\"\n}"
            },
            "url": {
              "raw": "{{n8n_base_url}}/webhook/mpesa/stk-push",
              "host": ["{{n8n_base_url}}"],
              "path": ["webhook", "mpesa", "stk-push"]
            }
          }
        },
        {
          "name": "Simulate Safaricom Callback (success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"29115-34620561-1\",\n      \"CheckoutRequestID\": \"{{checkout_request_id}}\",\n      \"ResultCode\": 0,\n      \"ResultDesc\": \"The service request is processed successfully.\",\n      \"CallbackMetadata\": {\n        \"Item\": [\n          { \"Name\": \"Amount\", \"Value\": 1 },\n          { \"Name\": \"MpesaReceiptNumber\", \"Value\": \"TEST12345\" },\n          { \"Name\": \"TransactionDate\", \"Value\": 20261001101530 },\n          { \"Name\": \"PhoneNumber\", \"Value\": 254708374149 }\n        ]\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{n8n_base_url}}/webhook/mpesa/stk-callback",
              "host": ["{{n8n_base_url}}"],
              "path": ["webhook", "mpesa", "stk-callback"]
            }
          }
        },
        {
          "name": "Simulate Callback (user cancelled)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"29115-34620561-1\",\n      \"CheckoutRequestID\": \"{{checkout_request_id}}\",\n      \"ResultCode\": 1032,\n      \"ResultDesc\": \"Request cancelled by user\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{n8n_base_url}}/webhook/mpesa/stk-callback",
              "host": ["{{n8n_base_url}}"],
              "path": ["webhook", "mpesa", "stk-callback"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "mpesa_base_url",    "value": "https://sandbox.safaricom.co.ke" },
    { "key": "consumer_key",      "value": "" },
    { "key": "consumer_secret",   "value": "" },
    { "key": "shortcode",         "value": "174379" },
    { "key": "passkey",           "value": "bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919" },
    { "key": "test_phone",        "value": "254708374149" },
    { "key": "callback_base_url", "value": "https://your-ngrok.ngrok-free.app" },
    { "key": "n8n_base_url",      "value": "http://localhost:5678" },
    { "key": "access_token",      "value": "" },
    { "key": "password",          "value": "" },
    { "key": "timestamp",         "value": "" },
    { "key": "checkout_request_id", "value": "" }
  ]
}

