    {
      "parameters": {
        "jsCode": "const f = $json.body;\nreturn [{ json: {\n  phone: f.parent_phone,\n  amount: parseInt(f.amount, 10),\n  reference: `FEES-${f.admission_number}`,\n  description: `Fees ${f.term}`,\n  pupil_name: f.pupil_name,\n  admission_number: f.admission_number,\n  parent_email: f.parent_email\n}}];"
      },
      "id": "e3000000-0000-0000-0000-000000000002",
      "name": "Parse Form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "value": "02-stk-push", "mode": "list" },
        "options": {}
      },
      "id": "e3000000-0000-0000-0000-000000000003",
      "name": "Trigger STK Push",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [640, 300]
    }
  ],
  "connections": {
    "Google Form Webhook": { "main": [[{ "node": "Parse Form", "type": "main", "index": 0 }]] },
    "Parse Form":          { "main": [[{ "node": "Trigger STK Push", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
