{
  "name": "Use Case — School Fees (Google Form → STK → Receipt)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "school/fees-submit", "responseMode": "lastNode", "options": {} },
      "id": "e3000000-0000-0000-0000-000000000001",
      "name": "Google Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
